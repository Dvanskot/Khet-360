# Caddyfile for Khet-360
# This is a basic configuration for local development.
# In production, Caddy will automatically handle HTTPS for *.khet360.co.za

:80 {
    # Redirect all HTTP traffic to HTTPS (uncomment in production)
    # redir https://{host}{uri}

    # Proxy Auth API requests to the AuthApi service on localhost:5001
    handle_path /api/auth/* {
        reverse_proxy localhost:5001
    }

    # Proxy other API requests to the .NET Backend (monolith) on localhost:8080
    handle_path /api/* {
        reverse_proxy localhost:8080
    }

    # Proxy Frontend requests to the Vue 3 app on localhost:3000
    handle {
        reverse_proxy localhost:3000
    }

    # Log requests for debugging
    log {
        output file /var/log/caddy/access.log
    }
}
