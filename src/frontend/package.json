{
  "name": "khet360-frontend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:all": "pnpm --parallel --stream dev",
    "dev:tenant-erp": "pnpm --filter @khet360/tenant-erp dev",
    "dev:tenant-mobile": "pnpm --filter @khet360/tenant-mobile dev",
    "dev:family-portal": "pnpm --filter @khet360/family-portal dev",
    "dev:vendor-hub": "pnpm --filter @khet360/vendor-hub dev",
    "dev:public-site": "pnpm --filter @khet360/public-site dev",
    "build:all": "pnpm --parallel build",
    "build:tenant-erp": "pnpm --filter @khet360/tenant-erp build",
    "build:tenant-mobile": "pnpm --filter @khet360/tenant-mobile build",
    "build:family-portal": "pnpm --filter @khet360/family-portal build",
    "build:vendor-hub": "pnpm --filter @khet360/vendor-hub build",
    "build:public-site": "pnpm --filter @khet360/public-site build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {},
  "devDependencies": {}
}
