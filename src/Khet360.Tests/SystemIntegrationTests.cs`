    [Fact]
    public async Task EndToEnd_InsuranceBurialClaim_Should_DeductStock_And_PostToLedger()
    {
        // Arrange
        var (sp, db, assignedBranches) = await GetServiceProviderAsync();
        var policyService = sp.GetRequiredService<IPolicyService>();
        var claimService = sp.GetRequiredService<IClaimService>();
        var inventoryService = sp.GetRequiredService<IInventoryService>();
        var branchId = Guid.NewGuid();
        assignedBranches.Add(branchId);
        db.Branches.Add(new Branch { Id = branchId, Name = "Main Branch" });
        await db.SaveChangesAsync();

        // 1. Setup Product and Stock
        var product = new FuneralProduct { Id = Guid.NewGuid(), Name = "Premium Casket", DefaultPrice = 2000m };
        db.FuneralProducts.Add(product);
        await inventoryService.InitializeStockAsync(product.Id, branchId, 10, Guid.NewGuid());

        // 2. Setup Burial Plan
        var plan = new InsurancePolicyPlan {
            Id = Guid.NewGuid(),
            Name = "Burial Plan",
            CoverType = InsuranceCoverType.Burial
        };
        db.InsurancePolicyPlans.Add(plan);

        var benefit = new InsurancePolicyPlanBenefit {
            Id = Guid.NewGuid(),
            PolicyPlanId = plan.Id,
            Role = MemberRole.Main,
            IsFixed = true,
            CoverAmount = 10000m
        };
        db.InsurancePolicyPlanBenefits.Add(benefit);

        db.InsurancePolicyPlanBenefitItems.Add(new InsurancePolicyPlanBenefitItem {
            BenefitId = benefit.Id,
            FuneralProductId = product.Id,
            Quantity = 1
        });
        await db.SaveChangesAsync();

        // 3. Setup Customer and Policy
        var customer = new IndividualCustomer { Id = Guid.NewGuid(), FirstName = "Test", LastName = "User", BranchId = branchId };
        db.Customers.Add(customer);
        await db.SaveChangesAsync();

        var policyDto = new PolicyCreateDto("POL-1", "Provider", 10000m, DateTime.UtcNow.AddMonths(-1), null, plan.Id, new List<PolicyMemberCreateDto> { new(customer.Id, MemberRole.Main) });
        var policyId = await policyService.CreatePolicyAsync(policyDto, branchId);

        var funeralCase = new FuneralCase { Id = Guid.NewGuid(), CustomerId = customer.Id, DeceasedCustomerId = customer.Id, BranchId = branchId };
        db.FuneralCases.Add(funeralCase);
        await db.SaveChangesAsync();

        var claimDto = new ClaimCreateDto("CLM-1", 10000m, policyId, funeralCase.Id, "Notes");
        var claimId = await claimService.CreateClaimAsync(claimDto, branchId);

        await claimService.UpdateClaimStatusAsync(claimId, new ClaimUpdateDto(ClaimStatus.Approved, DateTime.UtcNow, "Approved"));

        // Act
        await claimService.ExecutePayoutAsync(claimId);

        // Assert
        // 1. Stock should be decremented
        var stock = await inventoryService.GetStockLevelAsync(product.Id, branchId);
        stock.Should().Be(9);

        // 2. Ledger should have a balanced transaction
        var tx = await db.FinancialTransactions.FirstOrDefaultAsync(t => t.SourceEntityId == claimId);
        tx.Should().NotBeNull();
        var entries = await db.FinancialEntries.Where(e => e.FinancialTransactionId == tx!.Id).ToListAsync();
        entries.Sum(e => e.Debit).Should().Be(entries.Sum(e => e.Credit));
    }

    [Fact]
    public async Task EndToEnd_PayrollToFinance_Should_PostCorrectLiability()
    {
        // Arrange
        var (sp, db, assignedBranches) = await GetServiceProviderAsync();
        var payrollService = sp.GetRequiredService<IPayrollService>();
        var branchId = Guid.NewGuid();
        assignedBranches.Add(branchId);
        db.Branches.Add(new Branch { Id = branchId, Name = "Main Branch" });

        var dept = new Department { Id = Guid.NewGuid(), Name = "HR", BranchId = branchId };
        db.Departments.Add(dept);

        var pos = new Position { Id = Guid.NewGuid(), Title = "Manager" };
        db.Positions.Add(pos); // Since we move Positions to Platform, this might fail if we use TenantDbContext
        // Actually, we should use the platformDb for positions now.

        // Fix: Positions are now in PlatformDb. We just need the ID.
        var platformDb = sp.GetRequiredService<PlatformDbContext>();
        var platformPosId = platformDb.Positions.First().Id;

        var emp = new Employee { Id = Guid.NewGuid(), FirstName = "Payroll", LastName = "Test", BranchId = branchId, DepartmentId = dept.Id, PositionId = platformPosId };
        db.Employees.Add(emp);

        db.EmploymentContracts.Add(new EmploymentContract { Id = Guid.NewGuid(), EmployeeId = emp.Id, Salary = 10000m });
        db.PayProfiles.Add(new PayProfile { Id = Guid.NewGuid(), EmployeeId = emp.Id });

        db.PayItems.Add(new PayItem { Id = Guid.NewGuid(), Name = "Basic Salary", Code = "BASIC", Type = PayItemType.Earning });
        await db.SaveChangesAsync();

        var runId = await payrollService.CreatePayrollRunAsync(new PayrollRunCreateDto("Test Run", DateTime.UtcNow, DateTime.UtcNow.AddDays(30)));
        await payrollService.CalculatePayrollAsync(runId);
        await payrollService.FinalizePayrollRunAsync(runId, Guid.NewGuid());

        // Assert
        var tx = await db.FinancialTransactions.FirstOrDefaultAsync(t => t.SourceEntityId == runId);
        tx.Should().NotBeNull();

        var liabilityEntry = await db.FinancialEntries.FirstOrDefaultAsync(e => e.FinancialTransactionId == tx!.Id && e.AccountCode == "SARS-LIABILITY");
        liabilityEntry.Should().NotBeNull();
        liabilityEntry!.Credit.Should().BeGreaterThan(0);
    }
